        {
          "id": "00b0ca49-fb8c-4e08-af43-a8db9205104e",
          "name": "List the authenticated customer's orders",
          "request": {
            "name": "List the authenticated customer's orders",
            "description": {
              "content": "Requires a Bearer access token; unauthenticated GET redirected (302) to the login page. The storefront calls it with `?orderBy=created_at&sortedBy=desc&page=N`.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "checkout",
                "orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "1",
                  "description": "1-based page number."
                },
                {
                  "disabled": false,
                  "key": "orderBy",
                  "value": "<string>",
                  "description": "Comma-separated sort fields. Observed: `created_at`, `distance`, `has_events`, `has_promotion`, `trending_90_days`."
                },
                {
                  "disabled": false,
                  "key": "sortedBy",
                  "value": "<string>",
                  "description": "Sort direction applied to orderBy."
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "802a0a2b-a04e-4351-9917-0b57364099fd",
              "name": "A page of orders.",

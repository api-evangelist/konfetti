      "item": [
        {
          "id": "99c96716-b769-412e-aaf1-5b2b2537bdcd",
          "name": "Retrieve the authenticated customer's profile",
          "request": {
            "name": "Retrieve the authenticated customer's profile",
            "description": {
              "content": "Requires a Bearer access token; unauthenticated GET redirected (302) to the login page. The storefront calls it with `?include=customer,referralCoupon&with_session=1` and reads `data.balance.amount` (minor units).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "user",
                "profile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "include",
                  "value": "<string>",
                  "description": "Comma-separated relations to embed. Observed values for events: `categories`, `supplier`, `address`, `reviews`, and the dot-path `address.locality`. For categories: `thumbnail`. For the user profile: `customer`, `referralCoupon`."
                },
                {
                  "disabled": false,
                  "key": "with_session",
                  "value": "<integer>"
                }
              ],
              "variable": []
            },
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{bearerToken}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "0084e0d5-2b6c-4cb7-a1e5-e2f14d548e08",
              "name": "The customer profile.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v1",
                    "user",
                    "profile"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
                      "key": "include",
                      "value": "supplier,categories"
                    },
                    {
                      "key": "with_session",
                      "value": "<integer>"
                    }
                  ],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  }
                ],
                "method": "GET",

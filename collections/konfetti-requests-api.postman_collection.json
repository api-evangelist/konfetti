        {
          "id": "2845d724-0d0b-44e3-9a66-e292a00c074a",
          "name": "List experiences similar to a submitted date request",
          "request": {
            "name": "List experiences similar to a submitted date request",
            "description": {},
            "url": {
              "path": [
                "v1",
                "store",
                "date-requests",
                ":id",
                "similar-events"
